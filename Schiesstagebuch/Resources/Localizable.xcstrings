    "Aus, wenn drinnen geschossen wird; dann erscheint auch im Eintrag kein Wetter.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off when shooting indoors; the entry then shows no weather."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé pour le tir en salle ; l'entrée n'affiche alors pas de météo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato quando si tira al coperto; la voce non mostra allora alcun meteo."
