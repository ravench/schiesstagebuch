    "Mit einer Lebensdauer zeigt die App, wie weit der Lauf abgenutzt ist.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With an expected life, the app shows how worn the barrel is."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec une durée de vie, l'app indique l'usure du canon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una durata prevista, l'app mostra quanto è usurata la canna."
          }
        }
      }
    },
    "Mit mehr als einer wählst du sie pro Anlass. Neue Anlässe beginnen mit der obersten.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With more than one on, you pick one per event. New events start with the top one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'il y en a plusieurs, tu choisis pour chaque événement. Les nouveaux événements commencent avec le premier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ne attivi più di uno, lo scegli per ogni evento. I nuovi eventi iniziano con il primo."
          }
        }
      }
    },
    "Mit weniger als 5 Resultaten pro Los sind Quartile wenig aussagekräftig.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With fewer than 5 results per lot, quartiles say little."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec moins de 5 résultats par lot, les quartiles sont peu significatifs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con meno di 5 risultati per lotto, i quartili sono poco significativi."
          }
        }
      }
    },
