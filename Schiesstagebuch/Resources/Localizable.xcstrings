    "Wähle die Filter, die du besitzt. Nur diese erscheinen in der Auswahl. Bereits erfasste Einträge behalten ihren Filter.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the filters you own. Only these appear in the picker. Existing entries keep their filter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionne les filtres que tu possèdes. Seuls ceux-ci apparaissent dans la sélection. Les entrées existantes gardent leur filtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
