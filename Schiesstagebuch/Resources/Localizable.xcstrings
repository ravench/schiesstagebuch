    "Optional. Beim Erfassen eines Eintrags kannst du das Los auswählen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. You can pick the lot when logging an entry."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Tu peux choisir le lot en saisissant une entrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Puoi scegliere il lotto quando registri una voce."
          }
        }
      }
    },
    "Optional. Mit Max. Punkten berechnet die App den Prozentwert und den Schnitt pro Schuss.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. With max. points the app calculates the percentage and the average per shot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Avec les points max., l'app calcule le pourcentage et la moyenne par coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Con i punti max. l'app calcola la percentuale e la media per colpo."
          }
        }
      }
    },
    "Optional. Mit Ort und Schussrichtung schlägt die App vor, woher die Sonne kommt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. With the location and shooting direction, the app suggests where the sun comes from."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Avec le lieu et la direction de tir, l'app propose d'où vient le soleil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Con il luogo e la direzione di tiro, l'app propone da dove viene il sole."
          }
        }
      }
    },
    "Optional. Neue Einträge übernehmen die Werte des letzten Eintrags mit dieser Waffe.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. New entries take the values of the last entry with this firearm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Les nouvelles entrées reprennent les valeurs de la dernière entrée avec cette arme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Le nuove voci riprendono i valori dell'ultima voce con quest'arma."
          }
        }
      }
    },
    "Optional. Neue Einträge übernehmen die Werte des letzten Eintrags mit dieser Waffe. Deine Filter wählst du unter Einstellungen → Filter.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. New entries take the values of the last entry with this weapon. Choose your filters under Settings → Filter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Les nouvelles entrées reprennent les valeurs de la dernière entrée avec cette arme. Choisis tes filtres sous Réglages → Filtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Le nuove voci riprendono i valori dell'ultima voce con quest'arma. Scegli i tuoi filtri in Impostazioni → Filtro."
          }
        }
      }
    },
    "Optional. Ohne Resultat zählt die Summe der Einzelschüsse; mit Max. Punkten berechnet die App den Prozentwert.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Without a result the sum of the shots counts; with max. points the app calculates the percentage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Sans résultat, la somme des coups compte ; avec les points max., l'app calcule le pourcentage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Senza risultato conta la somma dei colpi; con i punti max. l'app calcola la percentuale."
          }
        }
      }
    },
    "Optional: Wetter pro Ablösung oder Serie, mit Uhrzeit, um Wechsel festzuhalten.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: weather per relay or series, with the time, to record changes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif : météo par relève ou série, avec l'heure, pour noter les changements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo: meteo per turno o serie, con l'ora, per annotare i cambiamenti."
          }
        }
      }
    },
