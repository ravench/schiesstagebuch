    "Weitere Läufe nur für Wechselläufe oder nach einem Laufwechsel. Dann zählt die App die Schüsse auch pro Lauf.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add barrels only for swappable barrels or after a barrel replacement. The app then also counts shots per barrel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'ajoute des canons que pour des canons interchangeables ou après un changement de canon. L'app compte alors aussi les coups par canon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi canne solo se intercambiabili o dopo una sostituzione. L'app conta allora anche i colpi per canna."
          }
        }
      }
    },
