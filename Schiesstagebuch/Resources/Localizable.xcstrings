    "Beim Erfassen werden nur diese Kaliber angeboten. Das Standardkaliber ist vorausgewählt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only these calibers are offered when logging. The default caliber is preselected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls ces calibres sont proposés lors de la saisie. Le calibre par défaut est présélectionné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la registrazione vengono proposti solo questi calibri. Il calibro predefinito è preselezionato."
