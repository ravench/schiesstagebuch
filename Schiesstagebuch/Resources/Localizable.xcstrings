    "Ab wann Erinnerungen nach Tagen zählen. Pro Waffe kannst du das ändern.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When day-based reminders start counting. You can change this per firearm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir de quand les rappels en jours comptent. Modifiable pour chaque arme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da quando contano i promemoria in giorni. Puoi cambiarlo per ogni arma."
          }
        }
      }
    },
