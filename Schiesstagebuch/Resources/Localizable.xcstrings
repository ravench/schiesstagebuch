    "Mindestens ein Kaliber. Mehrere, wenn das Patronenlager sie alle aufnimmt, z. B. .308 Win und 7.62 NATO.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one calibre. Several when the chamber takes them all, e.g. .308 Win and 7.62 NATO."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins un calibre. Plusieurs si la chambre les accepte tous, p. ex. .308 Win et 7.62 OTAN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno un calibro. Più di uno se la camera li accetta tutti, p. es. .308 Win e 7.62 NATO."
          }
        }
      }
    },
    "Mindestens ein Kaliber. Wechselläufe fügst du nach dem Sichern hinzu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one calibre. Add swappable barrels after saving."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins un calibre. Ajoute les canons interchangeables après l'enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno un calibro. Aggiungi le canne intercambiabili dopo il salvataggio."
          }
        }
      }
    },
    "Minor": {
