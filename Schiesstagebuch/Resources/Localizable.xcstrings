            "value": "Choose which extra fields your entries show."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis les champs supplémentaires de tes entrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quali campi aggiuntivi mostrano le tue voci."
          }
        }
      }
    },
