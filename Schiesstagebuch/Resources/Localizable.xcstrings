    "Ohne Datum gilt der Lauf seit jeher. Ein ausgebauter Lauf zählt keine neuen Einträge mehr.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a date the barrel counts as always fitted. A removed barrel no longer counts new entries."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans date, le canon est considéré comme toujours monté. Un canon démonté ne compte plus les nouvelles entrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza data la canna è considerata sempre montata. Una canna smontata non conta più nuove voci."
          }
        }
      }
    },
    "Ohne Kaliber": {
