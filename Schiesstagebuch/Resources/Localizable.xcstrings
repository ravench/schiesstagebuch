    "Ändert nur die Wörter in der App, deine Daten bleiben gleich.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only changes the words in the app, your data stays the same."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne change que les mots dans l'app, tes données restent les mêmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia solo le parole nell'app, i tuoi dati restano invariati."
