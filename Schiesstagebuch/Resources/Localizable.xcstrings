    "Einträge bleiben erhalten und zählen wieder nach Kaliber und Datum.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entries are kept and are matched by calibre and date again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entrées sont conservées et sont de nouveau attribuées par calibre et date."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci restano e vengono di nuovo attribuite per calibro e data."
          }
        }
      }
    },
    "Einträge bleiben erhalten, verlieren aber das Sportgerät. Archivieren behält alles.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entries are kept but lose their equipment. Archiving keeps everything."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entrées sont conservées mais perdent leur équipement. L'archivage conserve tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci restano, ma perdono l'attrezzo. Archiviare conserva tutto."
          }
        }
      }
    },
    "Einträge bleiben erhalten, verlieren aber die Waffe. Archivieren behält alles.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entries are kept but lose their firearm. Archiving keeps everything."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entrées sont conservées mais perdent leur arme. L'archivage conserve tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci restano ma perdono l'arma. L'archiviazione conserva tutto."
          }
        }
      }
    },
    "Einträge zählen für den Lauf ihres Kalibers, der an diesem Tag montiert war. Pflege-Erinnerungen zählen alle Schüsse der Waffe.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entries count for the barrel of their calibre that was fitted on that day. Maintenance reminders count all shots of the firearm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entrées comptent pour le canon de leur calibre monté ce jour-là. Les rappels d'entretien comptent tous les coups de l'arme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci contano per la canna del loro calibro montata quel giorno. I promemoria di manutenzione contano tutti i colpi dell'arma."
          }
        }
      }
    },
    "Einträge zählen für den Lauf ihres Kalibers, der an diesem Tag montiert war. Pflege-Erinnerungen zählen alle Schüsse des Sportgeräts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entries count for the barrel of their calibre that was fitted on that day. Maintenance reminders count all shots of the equipment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entrées comptent pour le canon de leur calibre monté ce jour-là. Les rappels d'entretien comptent tous les coups de l'équipement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci contano per la canna del loro calibro montata quel giorno. I promemoria di manutenzione contano tutti i colpi dell'attrezzo."
          }
        }
      }
    },
