    "Archivierte Waffen erscheinen nicht mehr bei neuen Einträgen, bleiben aber in Tagebuch und Statistik.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived firearms are no longer offered for new entries but stay in the log and statistics."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les armes archivées ne sont plus proposées pour les nouvelles entrées, mais restent dans le journal et les statistiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le armi archiviate non vengono più proposte per le nuove voci, ma restano nel diario e nelle statistiche."
          }
        }
      }
    },
