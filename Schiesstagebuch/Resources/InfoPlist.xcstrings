            "value": "Shooting Log"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journal de tir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diario di tiro"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standblätter direkt fotografieren und zum Eintrag speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos of score strips and save them with the entry."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographier les feuilles de stand et les enregistrer avec l'entrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografare i fogli di tiro e salvarli con la voce."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt beim neuen Eintrag die Schiessanlage, bei der du gerade bist. Der Standort wird nicht gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks the shooting range you are at when you start a new entry. Your location is not stored."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisit le stand de tir où tu te trouves lors d'une nouvelle entrée. La position n'est pas enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sceglie il poligono di tiro in cui ti trovi quando crei una nuova voce. La posizione non viene salvata."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos von Scheiben und Resultaten zu einem Eintrag hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add photos of targets and results to an entry."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter des photos de cibles et de résultats à une entrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungere foto di bersagli e risultati a una voce."
          }
        }
      }
    }
  },
  "version": "1.0"
}