    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiesstagebuch"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shooting Log"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journal de tir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diario di tiro"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt beim neuen Eintrag die Schiessanlage, bei der du gerade bist. Der Standort wird nur gespeichert, wenn du ihn als Ort einer Schiessanlage übernimmst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks the shooting range you are at when you start a new entry. Your location is only stored when you use it as the place of a shooting range."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisit le stand de tir où tu te trouves lors d'une nouvelle entrée. La position n'est enregistrée que si tu la reprends comme lieu d'un stand de tir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sceglie il poligono di tiro in cui ti trovi quando crei una nuova voce. La posizione viene salvata solo se la usi come luogo di un poligono di tiro."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos von Scheiben und Resultaten zu einem Eintrag hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add photos of targets and results to an entry."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter des photos de cibles et de résultats à une entrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungere foto di bersagli e risultati a una voce."
          }
        }
      }
    }
  },
  "version": "1.0"
}