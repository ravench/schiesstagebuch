{
  "sourceLanguage": "de",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiesstagebuch"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shooting Log"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journal de tir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diario di tiro"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt beim neuen Eintrag die Schiessanlage, bei der du gerade bist. Der Standort wird nur gespeichert, wenn du ihn als Ort einer Schiessanlage übernimmst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks the shooting range you are at when you start a new entry. Your location is only stored when you use it as the place of a shooting range."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisit le stand de tir où tu te trouves lors d'une nouvelle entrée. La position n'est enregistrée que si tu la reprends comme lieu d'un stand de tir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sceglie il poligono di tiro in cui ti trovi quando crei una nuova voce. La posizione viene salvata solo se la usi come luogo di un poligono di tiro."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Import aus «Schusszähler-Schiesstagebuch» die Fotos der alten Einträge aus der Mediathek übernehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring over the photos of the old entries from your library when importing from “Schusszähler-Schiesstagebuch”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre de la photothèque les photos des anciennes entrées lors de l'import depuis « Schusszähler-Schiesstagebuch »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprendere dalla libreria le foto delle vecchie voci durante l'importazione da «Schusszähler-Schiesstagebuch»."
          }
        }
      }
    }
  },
  "version": "1.0"
}